# Copia este archivo como .env y reemplaza los valores.
MONGODB_URI="mongodb+srv://USUARIO:CONTRASENA@tu-cluster.xxxxx.mongodb.net/tienda?retryWrites=true&w=majority"
# Base donde está la colección "products" (la que creaste en Atlas con "Create Database").
# Si la URI no incluye la base y esto queda vacío, Mongoose usa la base "test".
MONGODB_DB_NAME="NOMBRE_DE_TU_BASE"
PORT=4000
