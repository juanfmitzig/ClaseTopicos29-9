{
  "name": "graphql-productos",
  "version": "1.0.0",
  "description": "API GraphQL académica: Express + Apollo Server + MongoDB Atlas (Mongoose)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
